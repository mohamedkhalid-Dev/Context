# Backend env template — NEVER commit real secrets. Copy to .env and fill in.
# The OpenRouter key lives ONLY in browser localStorage (device-only) in the
# primary direct-to-OpenRouter mode; these server vars are for the OPTIONAL
# Laravel fallback (disabled by default) + Supabase JWT verification.
APP_KEY=
APP_URL=http://localhost:8000
SUPABASE_JWT_SECRET=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
DB_CONNECTION=pgsql
