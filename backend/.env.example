# Backend env template — NEVER commit real secrets. Copy to .env and fill in.
# The OpenRouter key lives ONLY in browser localStorage (device-only) in the
# primary direct-to-OpenRouter mode; these server vars are for the OPTIONAL
# Laravel fallback (disabled by default) + Supabase JWT verification.
APP_NAME=Context
APP_ENV=production
# SECURITY: must stay false in production — true leaks stack traces/paths.
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
# Frontend origin allowed for CORS (no trailing slash). Production: your
# https://<app>.vercel.app or custom domain. Never use * with credentials.
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
DB_CONNECTION=pgsql
# Cookie flags for Laravel sessions (when backend sessions are enabled):
# Secure + HttpOnly + SameSite=lax. Only set SECURE=false for http localhost.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
