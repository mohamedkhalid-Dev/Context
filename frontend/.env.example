# NEVER commit real secrets. Copy to .env.local and fill in.
# Public values only — the OpenRouter key lives ONLY in browser
# localStorage (`understoodchat:openrouter_key`), never in env files.
# On Vercel: set these in Project Settings → Environment Variables
# (Root Directory must be `frontend`, framework preset Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Production site URL used for canonical / OG tags (Vercel requirement).
# Set to your Vercel URL (https://your-app.vercel.app) or custom domain.
NEXT_PUBLIC_SITE_URL=https://context-teal-nine.vercel.app
# Default model id. The in-app Model Picker (live GET openrouter.ai/api/v1/models)
# overrides this per-device via localStorage `understoodchat:openrouter_model`.
NEXT_PUBLIC_OPENROUTER_MODEL=openrouter/auto
